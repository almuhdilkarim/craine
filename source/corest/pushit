#######################################
##--- PRESET
#######################################


function craine_update_preset_majors() {

    craine_update_datums_preps
    craine_update_remote_avail
    craine_update_versio_major
}


function craine_update_preset_minors() {

    craine_update_datums_preps
    craine_update_remote_avail
    craine_update_versio_minor
}


function craine_update_preset_patchs() {

    #--[1] populate preset data
    craine_update_datums_pooled


    #--[1] validate preset keys
    craine_update_remote_secret


    #--[1] validate preset toke
    craine_update_remote_tokens


    #--[1] validate preset host
    craine_update_remote_hosted


    #--[1] update patch numbers
    craine_update_versio_patchs


    #--[1] defined commit texts
    craine_update_remote_commit


    #--[1] update patch number
    craine_update_remote_pushed
}


function craine_update_preset() {

    if [[ $option_mode == "minor" ]]; then

        craine_update_preset_minors

    elif [[ $option_mode == "major" ]]; then

        craine_update_preset_majors

    else

        craine_update_preset_patchs
    fi
}



