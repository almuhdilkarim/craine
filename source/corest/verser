# (4) level fatal notif
function craine_update_notife_fail() {
    ##--[1] declare varible for error code and text message
    local text=""
    local code="$1" 


    ##--[2] selection text message based on error code
    
    ##---(410) helper 
    test $code == 4101 && text="update default $action_data successfull" 
    

    ##---(420) preset
    test $code == 4201 && text="conflicting name, $base_name $spin_name preset is existing"


    ##---(430) proset
    test $code == 4301 && text="update default $action_data successfull"


    ##---(440) protos
    test $code == 4301 && text="update default $action_data successfull"



    ##--[3] render message
    test -n "$text" && craine_notif_abort "$text" "$code"
    
    exit 0

    ##--[4] clean variable
    unset code && unset text
}


# (4) level fatal loging
function craine_update_logger_fail() {
    echo debug
}


# notife corest 
function craine_update_notlog() {

    local type="$1"
    local code="$2"

    if [[ $type == 1 ]];then
        craine_update_notife_info "$code"
        craine_update_logger_info "$code"
    fi

    if [[ $type == 2 ]];then
        craine_update_notife_warn "$code"
        craine_update_logger_warn "$code"
    fi

    if [[ $type == 3 ]];then
        craine_update_notife_errs "$code"
        craine_update_logger_errs "$code"
    fi

    if [[ $type == 4 ]];then
        craine_update_notife_fail "$code"
        craine_update_logger_fail "$code"
    fi
}


#######################################
##--- PROGRES
#######################################


##--[1] validate secret
function craine_update_remote_keys () {


    #--[1] initialzer ssh-agents
    if [[ ! -f $worker_secret/master  ]];then    
        return
    fi


    #--[2] initialzer ssh-agents 
    eval "$(ssh-agent -s)" > /dev/null 2>&1 &&


    #--[3] add secret to ssh agent 
    ssh-add $worker_secret/master > /dev/null 2>&1


    #--[4] connection test to github
    yes | ssh -T git@github.com >  /dev/null 2>&1

    
    #--[5] validate ssh connection
    cd $path_spin && git ls-remote --exit-code $repo_sshd > /dev/null 2>&1
    

    #--[1] validate ssh connection
    if [[ $? -eq 0 ]]; then
        sshd_stat=true 
    fi
}


##--[2] validate tokens
function craine_update_remote_toke () {


    #--[1] validate ssh connection, return false is ssh connection available
    if [[ $sshd_stat == true ]];then
        return
    fi


    #--[2] check personal access tokens available, exit with error code if not exist
    if [[ -z toke_data ]];then
        echo "no remote resources available" && exit 1
    fi


    #--[3] validate uri connection
    cd $path_spin && git remote set-url origin "$repo_keys"


    #--[4] validate uri connection
    test -z $http_keys && cd $path_spin &&  git ls-remote --exit-code $repo_http > /dev/null 2>&1


    #--[5] validate uri connection
    if [[ $? -ne 0 ]]; then

        #--[5-1] validate uri connection
        cd $path_spin && git remote set-url origin "$base_repo"

        #--[5-2] validate uri connection
        echo "no remote resources available" && exit 1
    fi


    #--[6] validate uri connection
    http_stat=true 


    #--[7] validate uri connection
    cd $path_spin && git remote set-url origin "$base_repo"
}


##--[3] validate tokens
function craine_update_remote_pool () {

    #--[1] validate uri connection
    cd $path_spin && git add . &&


    #--[2] validate uri connection
    cd $path_spin && git commit -m "update version $ver_major.$ver_minor.$ver_patch at $(date '+%A %W %Y %X')"
}


##--[4] validate tokens
function craine_update_remote_push () {

    #--[1] pushed using sshd connection
    if [[ $shhd_stat == true  ]]; then

        #--[1.1] pushed using sshd connection
        cd $path_spin && git push &&

        #--[1.2] pushed using sshd connection
        return
    fi


    #--[2] pushed using http connection
    if [[ $http_stat == true  ]]; then

        #--[2.1] pushed using sshd connection
        cd $path_spin && git remote set-url origin "$repo_keys"

        #--[2.2] pushed using sshd connection
        cd $path_spin && git push &&

        #--[2.3] pushed using sshd connection
        cd $path_spin && git remote set-url origin "$base_repo"
    fi   
}



