function craine_create() { 

    test -z $action_data && craine_create_notlog 4 1
    

    if [[ $action_data == "preset" ]]; then
        unset crain_data && craine_create_preset && exit 0
    fi

    if [[ $action_data == "proset" ]]; then
        unset crain_data && craine_create_proset && exit 0
    fi

    if [[ $action_data == "protos" ]]; then
        unset crain_data && craine_create_protos && exit 0
    fi

    if [[ $action_data == "release" ]]; then
        unset crain_data && craine_create_images && exit 0
    fi

    if [[ $action_data == "testing" ]]; then
        unset crain_data && craine_create_tester && exit 0
    fi
}
