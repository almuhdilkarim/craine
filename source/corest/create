# (4) level fatal notif
function craine_create_notife_fail() {
    ##--[1] declare varible for error code and text message
    local text=""
    local code="$1" 


    ##--[2] selection text message based on error code
    
    ##---(410) helper 
    test $code == 4101 && text="update default $action_data successfull" 
    

    ##---(420) preset
    test $code == 4201 && text="conflicting name, $base_name $spin_name preset is existing"


    ##---(430) proset
    test $code == 4301 && text="update default $action_data successfull"


    ##---(440) protos
    test $code == 4301 && text="update default $action_data successfull"



    ##--[3] render message
    test -n "$text" && craine_notif_abort "$text" "$code"
    
    exit 0

    ##--[4] clean variable
    unset code && unset text
}


# (4) level fatal loging
function craine_create_logger_fail() {
    echo debug
}


# notife corest 
function craine_create_notlog() {

    local type="$1"
    local code="$2"

    if [[ $type == 1 ]];then
        craine_create_notife_info "$code"
        craine_create_logger_info "$code"
    fi

    if [[ $type == 2 ]];then
        craine_create_notife_warn "$code"
        craine_create_logger_warn "$code"
    fi

    if [[ $type == 3 ]];then
        craine_create_notife_errs "$code"
        craine_create_logger_errs "$code"
    fi

    if [[ $type == 4 ]];then
        craine_create_notife_fail "$code"
        craine_create_logger_fail "$code"
    fi
}




