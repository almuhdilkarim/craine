# (1) level info notif
function craine_create_notife_info() {


    ##--[1] declare varible for error code and text message
    local text=""
    local code="$1" 


    ##--[2] selection text message based on error code
    
    ##---(110) helper 
    test $code == 1101 && text="update default $action_data successfull" 
    

    ##---(120) preset
    test $code == 1201 && text="checking and prepare deployment target"
    test $code == 1202 && text="checking install sources availablility"
    test $code == 1203 && text="checking targets sources availablility"
    test $code == 1204 && text="creating targets sources workdirectory"
    test $code == 1205 && text="install modules to working directories"
    test $code == 1206 && text="create access tokens vault directories"
    test $code == 1207 && text="add personal access token to vaultfile"
    test $code == 1208 && text="writing user input data to tmp presets"
    test $code == 1209 && text="clone remote sources to working folder"
    test $code == 1210 && text="install preset to remote source folder"
    test $code == 1211 && text="purifiying source at temporary presets"


    ##---(130) proset
    test $code == 1301 && text="update default $action_data successfull"


    ##---(140) protos
    test $code == 1301 && text="update default $action_data successfull"



    ##--[3] render message
    test -n "$text" && craine_notif_stage "$text"
    

    ##--[4] clean variable
    unset code && unset text
}


