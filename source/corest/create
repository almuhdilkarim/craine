# 1 | command line base data organizer
function craine_create_enviro_preper() {


    ## logic variable
    option_spin=$( [[ -z $option_spin ]] && echo "default" || echo "$option_spin" )


    ## base variable
    base_name=$( craine_string_toname ${option_name} )
    base_slug=$( craine_string_toslug ${option_name} )
    base_lead=$( craine_string_tolead ${option_name} )
    base_vars=$( craine_string_tovars ${option_name} )
    


    ## spin variablbase_namee
    spin_name=$( craine_string_toname ${option_spin} )
    spin_slug=$( craine_string_toslug ${option_spin} )
    spin_lead=$( craine_string_tolead ${option_spin} )
    spin_vars=$( craine_string_tovars ${option_spin} )
    


    ## author variable
    auth_name=$( craine_string_toname "$option_auth" )    
    auth_lead=$( craine_string_toslug "$option_auth" )    
    auth_slug=$( craine_string_tolead "$option_auth" )    
    auth_vars=$( craine_string_tovars "$option_auth" ) 



    ## locals variable
    vars_rand=$( craine_string_random )
    path_base="$worker_folder/$action_data"
    path_main="$path_base/$base_slug"                                       # distros folders
    path_rand="$path_main/$vars_rand"                                       # temporary paths
    path_spin="$path_main/$spin_slug"                                       # variant folders



    ## remote variable
    repo_toke="$worker_folder/tokens/$action_data/$base_slug/$spin_slug"    # repository apts
    repo_host=$( craine_reposi_tohost $option_repo )                        # repository host
    repo_user=$( craine_reposi_touser $option_repo )                        # repository user
    repo_name=$( craine_reposi_torepo $option_repo )                        # repository name
    repo_http=$( craine_reposi_tohttp $option_repo )                        # repository link
    repo_sshd=$( craine_reposi_tosshd $option_repo )                        # repository name
    repo_push=$( craine_reposi_topush $option_repo )                        # repository push
    repo_keys="$worker_secret/master"                                       # repository sshd



    ## tokens variable
    toke_path="$repo_toke/repo"                                             # tokneizers path
    toke_data="$option_keys"                                                # tokneizers data
    


    ## notife variable
    stage_num=1
    alert_num=1
    erorr_num=1



    ##-- relative path replacement 
    ##   replace absolute home variable with tilda (~), fix perset creating function building 
    
    local worker_repdir="~/.local/craine"
    local worker_repsec="~/.ssh/crainkey/"

    rpat_base="$worker_repdir/$action_data"                                 # module directory
    rpat_main="$worker_repdir/$base_slug"                                   # distro directory
    rpat_spin="$worker_repdir/$vars_spin"                                   # varian directory
    rrep_keys="$worker_repsec/master"                                       # secret directory
    rrep_toke="$worker_repdir/tokens/$action_data/$base_slug/$vars_spin"    # tokens directory
}


