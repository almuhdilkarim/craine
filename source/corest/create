#--| display starting message and load modulars
function craine_create_preset_booter () {


    #--[1] validate build preset
    test -d $path_spin && craine_create_notlog 4 4201


    #--[2] starting build preset
    craine_baner_prime
    echo -e  "\t${green}  PREPARE BUILD MODULE                                              ${reset}" | sed 's/^[[:space:]]*//'
    echo -e  "\t${green} -------------------------------------------------------------------${reset}" | sed 's/^[[:space:]]*//'
}


#--| clone default preset to temporer directory
function craine_create_preset_prepar () {

    local path_core="$path_base/default"


    #--[1] checks preset working directory
    test -d $path_rand && craine_create_notlog 1 1202


    #--[2] checks preset master directory
    test -d $path_core && craine_create_notlog 1 1203


    #--[3] create preset working directory
    mkdir -p $path_rand &&

    if [[ $? -eq 0 ]]; then
        craine_create_notlog 1 1204
    else
        craine_create_notlog 3 1204
    fi

    
    #--[4] clone default preset to workdir
    cp -fr $path_core/* $path_rand &&

    if [[ $? -eq 0 ]]; then
        craine_create_notlog 1 1205
    else
        craine_create_notlog 3 1205
    fi


    #--[5] create tokens pat access folders
    mkdir -p $repo_toke &&

    if [[ $? -eq 0 ]]; then
        craine_create_notlog 1 1206
    else
        craine_create_notlog 3 1206
    fi


    #--[6] write token data to vault folder
    echo "$toke_data" > "$toke_path" &&
    
    if [[ $? -eq 0 ]]; then
        craine_create_notlog 1 1207
    else
        craine_create_notlog 3 1207
    fi

    unset path_core
}


