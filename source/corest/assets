    echo -e "\t${white} ___________________    _____  .___ _______  ___________      ${reset}" | sed 's/^[[:space:]]*//' &&
    echo -e "\t${white} \_   ___ \______   \  /  _  \ |   |\      \ \_   _____/      ${reset}" | sed 's/^[[:space:]]*//' &&
    echo -e "\t${white} /    \  \/|       _/ /  /_\  \|   |/   |   \ |    __)_       ${reset}" | sed 's/^[[:space:]]*//' &&
    echo -e "\t${white} \     \___|    |   \/    |    \   /    |    \|        \      ${reset}" | sed 's/^[[:space:]]*//' &&
    echo -e "\t${white}  \______  /____|_  /\____|__  /___\____|__  /_______  /      ${reset}" | sed 's/^[[:space:]]*//' &&
