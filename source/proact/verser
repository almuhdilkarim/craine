#######################################
##--- PRESET
#######################################


function craine_update_preset () {

    if [[ $option_mode == "minor" ]]; then

        craine_update_verses_mino

    elif [[ $option_mode == "major" ]]; then

        craine_update_verses_majo

    else

        craine_update_verses_bufi
    fi
}



