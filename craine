#!/bin/bash

set -e



## TAKE OPTIONS
while getopts "c:l:o:n:b:d:m:a:r:p:s:k:" opt; do
    case $opt in
        c) craine_proc="create" && craine_data="${OPTARG}"
        ;;
        l) craine_proc="lister" && craine_data="${OPTARG}"
        ;;
        n) craine_name="${OPTARG}"
        ;;
        s) craine_spin="${OPTARG}"
        ;;
        r) craine_repo="${OPTARG}"
        ;;
        k) craine_keys="${OPTARG}"
        ;;
        o) craine_outp="${OPTARG}"
        ;;
        b) craine_base="${OPTARG}"
        ;;
        d) craine_dist="${OPTARG}"
        ;;
        m) craine_mode="${OPTARG}"
        ;;
        a) craine_auth="${OPTARG}"
        ;;
        p) craine_pitc="${OPTARG}"
        ;;
    esac
done


## CRAINE ENVI
craine_devs=true
craine_libs="/var/lib/craine" 
test -n $crdevs_stat && craine_libs=$(pwd)/library
source "$craine_libs/corest/loader"


## CRAINE PROC
test -z $craine_proc && craine_loging_errors 'Operation parameter not found'


if [[ $craine_proc == "create" ]];then
    craine_create
fi

exit 0
## CRAINE MAIN
if [[ $craine_proc == "create" ]];then
    
    craine_create
elif [[ $craine_proc == "desktop" ]];then
    craine_guimode
elif [[ $craine_proc == "guides" ]];then
    craine_diamode
elif [[ $craine_proc == "tester" ]];then
    craine_testers
elif [[ $craine_proc == "proset" ]];then

    craine_proset $craine_mode
elif [[ $craine_proc == "preset" ]];then
        echo $craine_proc
    craine_preset $craine_mode
elif [[ $craine_proc == "protos" ]];then
    craine_protos $craine_mode
elif [[ $craine_proc == "editor" ]];then
    craine_editors
fi
 
       




unset craine_auth
unset craine_base
unset craine_name
unset craine_mode
unset craine_link
unset craine_pitc
unset craine_devs
unset craine_libs
